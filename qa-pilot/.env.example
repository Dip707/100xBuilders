# --- LLM -------------------------------------------------------------------
# Talking to Anthropic directly: set a real key and nothing else here.
ANTHROPIC_API_KEY=sk-ant-...
QA_PILOT_MODEL=claude-opus-5

# Running on a Gemini key through the LiteLLM proxy instead
# (start it with ./scripts/litellm-proxy.sh, then uncomment these):
# GEMINI_API_KEY=...
# QA_PILOT_LLM_BASE_URL=http://localhost:4444
# ANTHROPIC_API_KEY=sk-local-dev          # the proxy's master_key; the SDK requires a key
# QA_PILOT_MODEL=gemini-3.8-flash           # must match a model_name in litellm.config.yaml

# Transport retries. Defaults ride out roughly 30s of provider trouble; raise
# QA_PILOT_LLM_MAX_RETRIES if a model is being flaky for longer than that.
# QA_PILOT_LLM_MAX_RETRIES=5
# QA_PILOT_LLM_RETRY_BASE_MS=1000
# QA_PILOT_LLM_RETRY_CAP_MS=30000

# --- Storage ---------------------------------------------------------------
# Optional. Without it the process uses the in-memory store and everything is
# lost on restart. Set it to keep runs and accounts across restarts.
# QA_PILOT_MONGO_URL=mongodb+srv://...
# QA_PILOT_MONGO_DB=qa_pilot
# QA_PILOT_STORE=mongo                    # force Mongo; fail loudly if the URL is missing

# --- Runtime ---------------------------------------------------------------
QA_PILOT_HEADLESS=1
QA_PILOT_API_PORT=4000
# Accessibility-snapshot budget in characters for prompts that carry one (0 = uncapped).
# Lower it for a small model that loses the thread in a long observation; raise or disable it
# for a frontier model with a large thinking budget, which does better with the raw tree.
# QA_PILOT_MAX_SNAPSHOT_CHARS=12000
# QA_PILOT_SCREENCAST=1
# QA_PILOT_OUTPUT=qa-pilot/output/
